{
  "name": "minepanel",
  "private": true,
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.23.0"
  },
  "scripts": {
    "dev": "pnpm --filter @mmsmanager/shared build && pnpm --parallel --filter @minepanel/api --filter @minepanel/web dev",
    "build": "pnpm --filter @mmsmanager/shared build && pnpm --parallel --filter @minepanel/api --filter @minepanel/web build",
    "lint": "pnpm --filter @minepanel/api lint && pnpm --filter @minepanel/web lint",
    "typecheck": "pnpm --filter @mmsmanager/shared build && pnpm --filter @minepanel/api typecheck && pnpm --filter @minepanel/web typecheck",
    "test": "pnpm --parallel --filter @minepanel/api --filter @minepanel/web test",
    "e2e": "pnpm --filter @minepanel/web e2e"
  }
}
